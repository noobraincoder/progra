#include <iostream>
#include <string>
//angel uriel perez  
using namespace std;

bool verificarLetra(char letra, string palabra, string &progreso);
void mostrarEstado(string progreso, string fallidas, int vidas);

int main() {
    char opcionJuego;
    
    do {
        string palabraSecreta = "";
        int modo;
        
        cout << "--- ADIVINA LA PALABRA ---" << endl;
        cout << "1. Contra la computadora" << endl;
        cout << "2. Contra un amigo" << endl;
        cout << "Selecciona modo: ";
        cin >> modo;

        if (modo == 1) {
            palabraSecreta = "INGENIERIA"; 
        } else {
            cout << "Ingresa la palabra a adivinar (en MAYUSCULAS): ";
            cin >> palabraSecreta;
            for(int i = 0; i < 30; i++) cout << endl;
        }

        for (int i = 0; i < palabraSecreta.length(); i++) {
            palabraSecreta[i] = toupper(palabraSecreta[i]);
        }

        string progreso = "";
        for(int i = 0; i < palabraSecreta.length(); i++) {
            progreso += "_";
        }

        string letrasFallidas = "";
        int intentosFallidos = 0;
        const int MAX_INTENTOS = 7;

        while (intentosFallidos < MAX_INTENTOS && progreso != palabraSecreta) {
            char letraUsuario;
            
            mostrarEstado(progreso, letrasFallidas, MAX_INTENTOS - intentosFallidos);
            
            cout << "Introduce una letra: ";
            cin >> letraUsuario;
            letraUsuario = toupper(letraUsuario);

            if (!verificarLetra(letraUsuario, palabraSecreta, progreso)) {
                if (letrasFallidas.find(letraUsuario) == string::npos) {
                    letrasFallidas += letraUsuario;
                    letrasFallidas += " ";
                    intentosFallidos++;
                    cout << "\n>>> INCORRECTO <<<" << endl;
                } else {
                    cout << "\n(Ya habias intentado la " << letraUsuario << ")" << endl;
                }
            } else {
                cout << "\n>>> ¡ACERTASTE UNA LETRA! <<<" << endl;
            }
        }

        if (progreso == palabraSecreta) {
            cout << "\n===================================" << endl;
            cout << "   ¡GANASTE! La palabra es: " << palabraSecreta << endl;
            cout << "===================================" << endl;
        } else {
            cout << "\n===================================" << endl;
            cout << "   PERDISTE. La palabra era: " << palabraSecreta << endl;
            cout << "===================================" << endl;
        }

        cout << "¿Quieres jugar de nuevo? (s/n): ";
        cin >> opcionJuego;

    } while (opcionJuego == 's' || opcionJuego == 'S');

    cout << "Gracias por jugar, Angel." << endl;
    return 0;
}

bool verificarLetra(char letra, string palabra, string &progreso) {
    bool encontrada = false;
    for (int i = 0; i < palabra.length(); i++) {
        if (palabra[i] == letra) {
            progreso[i] = letra;
            encontrada = true;
        }
    }
    return encontrada;
}

void mostrarEstado(string progreso, string fallidas, int vidas) {
    cout << "\n-----------------------------------" << endl;
    cout << "Vidas restantes: " << vidas << endl;
    
    cout << "Palabra actual: ";
    for(int i = 0; i < progreso.length(); i++) {
        cout << progreso[i] << " ";
    }
    
    cout << "\nLetras falladas: [ " << fallidas << "]" << endl;
    cout << "-----------------------------------" << endl;
}
